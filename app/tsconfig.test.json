{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node"]
  },
  "include": [
    "modules/auth/fluxaFlow.ts",
    "lib/google-auth.ts",
    "i18n/messages.ts",
    "i18n/languages.ts",
    "tests/**/*.test.ts"
  ]
}
