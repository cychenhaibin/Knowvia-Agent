QQA_SERVER_ADDR=0.0.0.0:8088
QQA_STORE_BACKEND=postgres
QQA_JWT_SECRET=change-me
QQA_ACCESS_TTL_MINUTES=30
QQA_REFRESH_TTL_HOURS=168
# inline 表示任务在 API 进程内执行；redis 表示投递到 Redis 并由独立 worker 执行。
QQA_QUEUE_MODE=inline
# 当 QQA_QUEUE_MODE=redis 时使用的 Redis 地址；支持 host:port 或 redis:// URL。
QQA_REDIS_ADDR=127.0.0.1:6380
# Redis 队列名前缀；默认 knowvia:tasks，可按环境隔离。
QQA_QUEUE_NAME=knowvia:tasks
# Redis worker 并发数。
QQA_QUEUE_WORKERS=4
# 最大重试次数；超过后会进入 failed 队列。
QQA_QUEUE_MAX_ATTEMPTS=5
# 队列阻塞拉取超时，单位秒。
QQA_QUEUE_POLL_TIMEOUT_SECONDS=5
# 指数退避起始时间，单位秒。
QQA_QUEUE_RETRY_BASE_SECONDS=2
# 指数退避最大时间，单位秒。
QQA_QUEUE_RETRY_MAX_SECONDS=120
# worker 指标日志输出周期，单位秒。
QQA_QUEUE_METRICS_LOG_SECONDS=30
# worker 优雅退出等待时间，单位秒。
QQA_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=15
# 队列幂等键保留时间，单位秒；用于避免同一任务在队列生命周期内重复入队。
QQA_QUEUE_DEDUP_TTL_SECONDS=21600
QQA_POSTGRES_DSN=postgres://USER@127.0.0.1:5432/quickque_agent?sslmode=disable
QQA_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
QQA_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
QQA_MICROSOFT_TENANT_ID=consumers
# Optional server-owned FluxA identity origins. Clients send only paid/free.
QQA_FLUXA_PAID_ORIGIN=https://fluxa.camila.qzz.io
QQA_FLUXA_FREE_ORIGIN=https://free.camila.qzz.io
QQA_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
QQA_OPENAI_API_KEY=
QQA_OPENAI_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
QQA_OPENAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QQA_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
QQA_PYTHON_PROXY_BASE_URL=http://127.0.0.1:8000
QQA_PYTHON_PROXY_USERNAME=test
QQA_PYTHON_PROXY_PASSWORD=test123
QQA_PYTHON_PROXY_DEVICE_INFO=quickque-agent-go-proxy
QQA_DEV_USERS=admin:admin123:QuickQue Admin
