# 语雀开放 API Token，用来拉取知识库和文档内容。
PY_YUQUE_TOKEN=
# 默认语雀用户/团队 login。
PY_YUQUE_GROUP=cychenhaibin
# 可选的知识库 namespace；不填时按运行时请求决定。
PY_YUQUE_NAMESPACE=

# 是否启用知识库问答模式。
PY_QA_MODE=true
# 初次召回候选文档数量。
PY_TOP_K_INITIAL=20
# 重排后最终保留的文档数量。
PY_TOP_K_RERANK=10

# 是否走 OpenAI 兼容接口；false 时走本地 Ollama。
PY_USE_OPENAI=true
# OpenAI 兼容接口密钥。
PY_OPENAI_API_KEY=ollama
# 对话模型名。
PY_OPENAI_MODEL=qwen3:8b
# OpenAI 兼容接口地址。
PY_OPENAI_API_BASE=http://127.0.0.1:11434/v1
# 单次生成最大 token 数。
PY_OPENAI_MAX_TOKENS=8192

# 本地 Ollama 模型名，仅在 PY_USE_OPENAI=false 时生效。
PY_OLLAMA_MODEL=qwen3:8b
# Ollama 单次生成最大 token 数。
PY_OLLAMA_MAX_TOKENS=4096

# Embedding 模型名。
PY_BC_EMBED_MODEL=maidalun1020/bce-embedding-base_v1
# Rerank 模型名。
PY_BC_RERANK_MODEL=maidalun1020/bce-reranker-base_v1
# 向量维度，需和 embedding 模型一致。
PY_VECTOR_DIM=768
# FAISS 索引文件路径。
PY_FAISS_INDEX_PATH=./vectorstore/faiss.index
# 模型缓存目录。
PY_MODEL_CACHE_DIR=./models
QQA_PYTHON_PROXY_TOKEN=quickque-python-internal-dev-token
QQA_LLM_DATA_DIR=./data/internal
# auto: 有 Postgres DSN 时优先走 pgvector，否则回退到 file backend。
QQA_INDEX_BACKEND=auto
QQA_POSTGRES_DSN=
QQA_POSTGRES_SCHEMA=qqa_llm
QQA_POSTGRES_CONNECT_TIMEOUT=5
QQA_TRACE_RETENTION_DAYS=30
QQA_REPORT_TRACE_RETENTION_DAYS=90
QQA_GENERATOR_BACKEND=auto
# 默认快速知识问答温度；知识库问答通常建议保持低温度，减少随机发挥。
QQA_DEFAULT_CHAT_TEMPERATURE=0.05
# 默认高质量知识问答温度；和 chat_fast 一样推荐低温度，保证答案更稳。
QQA_DEFAULT_CHAT_QUALITY_TEMPERATURE=0.05
# 默认报告生成温度；报告可稍微高一点，但仍建议保持保守。
QQA_DEFAULT_REPORT_TEMPERATURE=0.1
QQA_EMBEDDING_BACKEND=auto
QQA_EMBEDDING_MODEL=text-embedding-3-small
QQA_BCE_EMBEDDING_MODEL=maidalun1020/bce-embedding-base_v1
QQA_RERANK_BACKEND=auto
QQA_RERANK_MODEL=
QQA_BCE_RERANK_MODEL=maidalun1020/bce-reranker-base_v1
QQA_EMBEDDING_DIM=384
QQA_CHUNK_SIZE=700
QQA_CHUNK_OVERLAP=120
QQA_LEXICAL_TOP_K=24
QQA_VECTOR_TOP_K=24
QQA_FUSION_TOP_K=20
QQA_RERANK_TOP_K=8
QQA_MAX_SOURCES=8
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_QUALITY_MODEL=gpt-4.1-mini
OPENAI_REPORT_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
